# Environment Configuration for AI-Augmented Query Compiler
# Copy this file to .env and fill in your API key:
#   copy .env.example .env

# Google Gemini API Key (Recommended - get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative - get key at https://platform.openai.com/)
OPENAI_API_KEY=
